<Page
    x:Class="ZapretMirrlyGUI.Pages.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
        </TransitionCollection>
    </Page.Transitions>

    <Grid Padding="{StaticResource PagePadding}">
        <TabView x:Name="GuideTabView" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
            <TabView.TabItems>

                <!-- ══════════════════════ TAB 1: SAFETY & GENERAL HELP ══════════════════════ -->
                <TabViewItem Header="Безопасность и общие справки" IsClosable="False">
                    <TabViewItem.Content>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Padding="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- ══════════════════════ HEADER ══════════════════════ -->
                                <StackPanel Grid.Row="0" x:Name="GuideHeaderPanel" Spacing="4" Margin="0,0,0,20">
                                    <TextBlock Text="Безопасность, Доверие и Справка" Style="{StaticResource PremiumPageTitleStyle}" FontSize="24" Foreground="{ThemeResource TitleTextGradientBrush}" />
                                    <TextBlock Text="Важная информация об открытом исходном коде, защите данных и ручном обновлении" Style="{StaticResource PremiumSubtitleStyle}" FontSize="12" />
                                </StackPanel>

                                <!-- ══════════════════════ 3-COLUMN LAYOUT ══════════════════════ -->
                                <Grid Grid.Row="1" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ─────────────── COLUMN 1: Warning + Open Source + Links ─────────────── -->
                                    <StackPanel Grid.Column="0" x:Name="GuideCol1" Spacing="12">
                                        <StackPanel.ChildrenTransitions>
                                            <TransitionCollection>
                                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="30" />
                                            </TransitionCollection>
                                        </StackPanel.ChildrenTransitions>

                                        <!-- Card 1: Scam Warning (amber accent) -->
                                        <Border CornerRadius="{StaticResource CardCornerRadius}" Padding="18" Background="#0AD19A66" BorderThickness="1.5">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#D19A66" Offset="0.0" />
                                                    <GradientStop Color="#8C663D" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" BorderThickness="1.5">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#3B2211" Offset="0.0" />
                                                                <GradientStop Color="#2B1A0E" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.BorderBrush>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#D19A66" Offset="0.0" />
                                                                <GradientStop Color="#8C663D" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.BorderBrush>
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <!-- Треугольник опасности -->
                                                                <Path Data="M12 3 L21.5 20 L2.5 20 Z M12 9 L12 14" Stroke="#D19A66" StrokeThickness="2.5" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Ellipse Canvas.Left="11" Canvas.Top="15.5" Width="2" Height="2" Fill="#D19A66"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="Остерегайтесь мошеннических сборок!" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" Foreground="#D19A66" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Text="Обход DPI — это сфера повышенного риска. В сети (особенно в Telegram-каналах и на сомнительных форумах) распространяются десятки «модифицированных» версий утилиты zapret. Многие из них содержат скрытые вирусы, стилеры паролей и майнеры. Скачивая файлы из непроверенных источников, вы рискуете личными переписками, игровыми аккаунтами и банковскими данными." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.9" TextWrapping="Wrap" />
                                                <!-- Highlighted warning callout -->
                                                <Border CornerRadius="6" Padding="10,8" Background="#18D19A66">
                                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                                        <Viewbox Grid.Column="0" Width="12" Height="12" VerticalAlignment="Top" Margin="0,1,0,0">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M12 3 L21.5 20 L2.5 20 Z M12 9 L12 14" Stroke="#D19A66" StrokeThickness="2.5" Fill="Transparent" StrokeLineJoin="Round"/>
                                                                <Ellipse Canvas.Left="11" Canvas.Top="15.5" Width="2" Height="2" Fill="#D19A66"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Grid.Column="1" Text="Никогда не запускайте исполняемые файлы (.exe) или скрипты (.bat), полученные из недостоверных источников!" Style="{StaticResource MirrlyTextSmallStyle}" FontWeight="SemiBold" Foreground="#D19A66" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 3: Open Source Community -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1.5">
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Ellipse Canvas.Left="9.5" Canvas.Top="2" Width="5" Height="5" Fill="#A79A83"/>
                                                                <Ellipse Canvas.Left="2" Canvas.Top="17" Width="5" Height="5" Fill="#A79A83"/>
                                                                <Ellipse Canvas.Left="17" Canvas.Top="17" Width="5" Height="5" Fill="#A79A83"/>
                                                                <Line X1="12" Y1="7" X2="4.5" Y2="17" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Line X1="12" Y1="7" X2="19.5" Y2="17" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Line X1="4.5" Y1="19.5" X2="19.5" Y2="19.5" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="Свобода, созданная сообществом" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Открытая разработка возвращает контроль над технологиями в руки пользователей. Пока крупные корпорации закрывают свои исходные коды и вводят ограничения, независимые разработчики объединяются, чтобы дарить людям свободу общения без цензуры, сторонних VPN-серверов и скрытых подписок. Проекты, подобные оригинальному zapret, доказывают: сила интернета — в децентрализации, прозрачности и взаимопомощи. Вместе мы делаем сеть безопаснее и доступнее для каждого." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.8" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Action Buttons -->
                                        <StackPanel Spacing="8" Margin="0,4,0,0">
                                            <TextBlock Text="Ссылки на доверенные проекты:" Style="{StaticResource MirrlyTextSmallStyle}" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" />
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                <Button Grid.Row="0" Grid.Column="0" Click="OpenOriginalZapretGithub_Click" Height="38" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="bol-van (zapret)" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Row="0" Grid.Column="1" Click="OpenFlowsealGithub_Click" Height="38" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="Flowseal (сборки)" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Row="1" Grid.Column="0" Click="OpenGoodbyeDpiGithub_Click" Height="38" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="ValdikSS (GoodbyeDPI)" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Row="1" Grid.Column="1" Click="OpenWinDivertGithub_Click" Height="38" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="basil00 (WinDivert)" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Click="OpenMirrlyGithub_Click" Height="38" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="Исходный код Mirrly GUI на GitHub" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ─────────────── COLUMN 2: Trust + Disclaimer ─────────────── -->
                                    <StackPanel Grid.Column="1" x:Name="GuideCol2" Spacing="12">
                                        <StackPanel.ChildrenTransitions>
                                            <TransitionCollection>
                                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="45" />
                                            </TransitionCollection>
                                        </StackPanel.ChildrenTransitions>

                                        <!-- Card 2: Trust & Transparency -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1.5">
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M8 12 Q8 5 12 5 Q16 5 16 12" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Rectangle Canvas.Left="5" Canvas.Top="12" Width="14" Height="10" RadiusX="2" RadiusY="2" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="2" Fill="Transparent"/>
                                                                <Ellipse Canvas.Left="10.5" Canvas.Top="15" Width="3" Height="3" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                                                <Line X1="12" Y1="18" X2="12" Y2="20" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="Политика доверия: Доверяй, но проверяй" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="Правило безопасности номер один в мире программного обеспечения: не верьте никому на слово — в том числе и мне, разработчику Mirrly GUI. Единственная гарантия чистоты софта — это полностью открытый исходный код (Open Source)." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.9" TextWrapping="Wrap" />

                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                                        <Ellipse Grid.Column="0" Width="4" Height="4" Fill="#A79A83" VerticalAlignment="Top" Margin="5,4,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="bol-van (original zapret): Создатель оригинального движка обхода блокировок DPI, ставшего стандартом прозрачности и эффективности." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.8" TextWrapping="Wrap" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                                        <Ellipse Grid.Column="0" Width="4" Height="4" Fill="#A79A83" VerticalAlignment="Top" Margin="5,4,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="Flowseal (сборки и прокси): Разработчик популярных конфигураций zapret-discord-youtube и прокси tg-ws-proxy, сделавший обход доступным широкой аудитории." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.8" TextWrapping="Wrap" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                                        <Ellipse Grid.Column="0" Width="4" Height="4" Fill="#A79A83" VerticalAlignment="Top" Margin="5,4,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="ValdikSS (GoodbyeDPI): Легендарный исследователь сетевых технологий в РФ и автор утилиты GoodbyeDPI." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.8" TextWrapping="Wrap" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                                        <Ellipse Grid.Column="0" Width="4" Height="4" Fill="#A79A83" VerticalAlignment="Top" Margin="5,4,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="basil00 (WinDivert): Автор мощного драйвера перехвата сетевых пакетов ядра Windows, используемого в GoodbyeDPI и zapret." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.8" TextWrapping="Wrap" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                                        <Ellipse Grid.Column="0" Width="4" Height="4" Fill="#A79A83" VerticalAlignment="Top" Margin="5,4,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="Оболочка Mirrly GUI: Исходный код этой графической программы также полностью открыт на GitHub. Любой независимый программист может проверить каждую строчку, скомпилировать приложение самостоятельно и убедиться, что в нем нет никаких скрытых угроз." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.8" TextWrapping="Wrap" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
                                                        <Ellipse Grid.Column="0" Width="4" Height="4" Fill="#A79A83" VerticalAlignment="Top" Margin="5,4,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="Архитектура: Создание Mirrly GUI — это моя личная инициатива, основанная на желании сделать использование открытых инструментов обхода DPI максимально удобным и простым для каждого пользователя через красивый графический интерфейс." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.8" TextWrapping="Wrap" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 4: Disclaimer -->
                                        <Border CornerRadius="{StaticResource CardCornerRadius}" Padding="20" Background="#05FFFFFF" BorderThickness="1.5">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#5A524A" Offset="0.0" />
                                                    <GradientStop Color="#2C2825" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="#211E1C" BorderBrush="#4A3F35" BorderThickness="1.5">
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M5 2 L5 22 L19 22 L19 7 L14 2 Z M14 2 L14 7 L19 7" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
                                                                <Line X1="12" Y1="10" X2="12" Y2="15" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Ellipse Canvas.Left="11" Canvas.Top="16.5" Width="2" Height="2" Fill="#A79A83"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="Отказ от ответственности" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" Foreground="#C0B49F" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Возможность подключения сторонней локальной папки &quot;zapret&quot; создана исключительно для удобства продвинутых пользователей. Автор Mirrly GUI не имеет никакого отношения к сторонним форкам и модификациям оригинальной утилиты, не тестирует их сборки и не несет абсолютно никакой ответственности за стабильность работы вашей системы, безопасность ПК или возможную кражу ваших данных при ручной установке и подмене файлов. Вся ответственность за проверку сторонних бинарников ложится целиком на вас." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.8" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- ─────────────── COLUMN 3: Why Manual + Guide ─────────────── -->
                                    <StackPanel Grid.Column="2" x:Name="GuideCol3" Spacing="12">
                                        <StackPanel.ChildrenTransitions>
                                            <TransitionCollection>
                                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="60" />
                                            </TransitionCollection>
                                        </StackPanel.ChildrenTransitions>

                                        <!-- Card 5: Why Manual Updates -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1.5">
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M17 12 Q17 17 12 17 Q7 17 7 12 Q7 7 12 7 Q15 7 17 9" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Path Data="M17 6 L17 9 L14 9" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="Почему обновление ручное?" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="Реализовать скрытое фоновое автообновление утилит обхода в один клик крайне сложно и небезопасно по следующим техническим причинам:" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.9" TextWrapping="Wrap" />

                                                <StackPanel Spacing="10" Margin="0,2,0,0">
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0">
                                                            <TextBlock Text="1" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="Системные блокировки файлов" FontWeight="SemiBold" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.9" />
                                                            <TextBlock Text="Утилита winws.exe и драйвер WinDivert работают на системном уровне как служба Windows. Во время работы файлы заблокированы ОС. Чтобы их заменить, нужно принудительно останавливать службу, выгружать драйвер из ядра системы, перезаписывать файлы и переустанавливать всё заново." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.7" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0">
                                                            <TextBlock Text="2" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="Права администратора (UAC)" FontWeight="SemiBold" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.9" />
                                                            <TextBlock Text="Любые манипуляции с системными службами и сетевыми драйверами требуют повышенных прав администратора. Скрытое автообновление постоянно вызывало бы назойливые системные окна запроса прав UAC." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.7" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0">
                                                            <TextBlock Text="3" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="Риск безопасности автоматической загрузки" FontWeight="SemiBold" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.9" />
                                                            <TextBlock Text="Если бы приложение умело само скачивать исполняемые (.exe) файлы из сети и запускать их с правами администратора, это создало бы потенциальную брешь (уязвимость RCE). Ручной контроль гарантирует, что вы точно знаете, какие файлы запускаются на вашем ПК." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.7" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0">
                                                            <TextBlock Text="4" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="Риск несовместимости версий" FontWeight="SemiBold" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.9" />
                                                            <TextBlock Text="Если разработчики утилиты изменят формат запуска, аргументы командной строки или структуру конфигураций в новой версии, автоматический запуск старого GUI на новой утилите сломает всю систему. Ручная замена позволяет вам легко контролировать совместимость." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.7" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 6: Step-by-Step Guide -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1.5">
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <!-- Нумерованный список -->
                                                                <Ellipse Canvas.Left="2" Canvas.Top="5" Width="4" Height="4" Fill="#A79A83"/>
                                                                <Ellipse Canvas.Left="2" Canvas.Top="11" Width="4" Height="4" Fill="#A79A83"/>
                                                                <Ellipse Canvas.Left="2" Canvas.Top="17" Width="4" Height="4" Fill="#A79A83"/>
                                                                <Line X1="9" Y1="7" X2="22" Y2="7" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Line X1="9" Y1="13" X2="22" Y2="13" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                <Line X1="9" Y1="19" X2="18" Y2="19" Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="Инструкция по ручному обновлению" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="Для обновления встроенной утилиты zapret (базовая версия в сборке: 1.9.9d) выполните следующие шаги:" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.9" TextWrapping="Wrap" />

                                                <StackPanel Spacing="10" Margin="0,2,0,0">
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0">
                                                            <TextBlock Text="1" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Перейдите по ссылке на официальный репозиторий утилиты zapret на GitHub (кнопка слева внизу)." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0">
                                                            <TextBlock Text="2" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Скачайте ZIP-архив новой версии релиза (например, zapret-discord-youtube-1.9.9d.zip)." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0">
                                                            <TextBlock Text="3" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Распакуйте скачанную папку и положите её прямо рядом с файлом ZapretMirrlyGUI.exe." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0">
                                                            <TextBlock Text="4" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Переименуйте распакованную папку (например, 'zapret-discord-youtube-1.9.9d') в простое имя zapret (если там уже была старая папка zapret, замените её)." Style="{StaticResource MirrlyTextSmallStyle}" FontWeight="SemiBold" Opacity="0.9" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0">
                                                            <TextBlock Text="5" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Полностью закройте приложение (выйдите из системного трея) и запустите его заново. GUI автоматически обнаружит локальную папку zapret рядом с собой и начнет использовать новые файлы!" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </TabViewItem.Content>
                </TabViewItem>

                <!-- ══════════════════════ TAB 2: MOBILE PROXY GUIDE ══════════════════════ -->
                <TabViewItem Header="Прокси на телефон (Tailscale + TgWsProxy)" IsClosable="False">
                    <TabViewItem.Content>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Padding="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" x:Name="MobileGuideHeaderPanel" Spacing="4" Margin="0,0,0,20">
                                    <TextBlock Text="Руководство: Проксирование Telegram и всего трафика на телефон" Style="{StaticResource PremiumPageTitleStyle}" FontSize="22" Foreground="{ThemeResource TitleTextGradientBrush}" />
                                    <TextBlock Text="Пошаговая инструкция по превращению ПК в узел разблокировок через Tailscale (Exit Node) + TgWsProxy" Style="{StaticResource PremiumSubtitleStyle}" FontSize="12" />
                                </StackPanel>

                                <!-- 2-COLUMN LAYOUT -->
                                <Grid Grid.Row="1" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ─────────────── COLUMN 1: Architecture + Step 1 + Step 2 + Step 3 ─────────────── -->
                                    <StackPanel Grid.Column="0" Spacing="12">

                                        <!-- Card: Architecture -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1.5">
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <!-- Иконка лампочки / идеи -->
                                                                <Path Data="M12 2 C8.14 2 5 5.14 5 9 C5 11.38 6.19 13.47 8 14.74 V17 C8 17.55 8.45 18 9 18 H15 C15.55 18 16 17.55 16 17 V14.74 C17.81 13.47 19 11.38 19 9 C19 5.14 15.86 2 12 2 Z M9 21 C9 21.55 9.45 22 10 22 H14 C14.55 22 15 21.55 15 21 V20 H9 V21 Z"
                                                                      Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="Как это работает (Архитектура)" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <TextBlock Text="1" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap">
                                                            <Run FontWeight="SemiBold">Tailscale (Exit Node):</Run> Создает защищенный виртуальный туннель между телефоном и ПК. Весь обычный трафик телефона (YouTube 4K, Discord, сайты) проходит через домашний Запрет.
                                                        </TextBlock>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <TextBlock Text="2" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap">
                                                            <Run FontWeight="SemiBold">TgWsProxy:</Run> Запущен внутри приложения на <Run FontFamily="Consolas">127.0.0.1:1080</Run> и обходит блокировки ТСПУ (DPI) для Telegram с помощью WebSocket-маскировки Cloudflare.
                                                        </TextBlock>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <TextBlock Text="3" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap">
                                                            <Run FontWeight="SemiBold">Windows PortProxy (netsh):</Run> Принимает входящий запрос с телефона на внешнем порту <Run FontFamily="Consolas">1443</Run> и пробрасывает его на <Run FontFamily="Consolas">127.0.0.1:1080</Run>. Предотвращает ошибки сокетов Windows.
                                                        </TextBlock>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card: Step 1 -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1.5">
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <!-- Иконка инструмента / настройки -->
                                                                <Path Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.7 4.7C.6 7.1 1 10.1 3 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.4-.4.4-1.1 0-1.4z"
                                                                      Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="ШАГ 1. Настройка TgWsProxy в ZapretMirrlyGUI" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="1. Запустите ZapretMirrlyGUI от имени администратора." Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="2. Убедитесь, что основной обход Запрет включен и работает." Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="3. Перейдите на вкладку TgWsProxy:" Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                    <StackPanel Margin="16,0,0,0" Spacing="4">
                                                        <TextBlock Text="• Хост (IP): 127.0.0.1 (НЕ меняйте на 0.0.0.0, чтобы не было конфликтов)" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" />
                                                        <TextBlock Text="• Порт: 1080" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" />
                                                        <TextBlock Text="• Нажмите «Запустить прокси»" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" />
                                                        <TextBlock Text="• Скопируйте Секрет (Secret) — он пригодится для Telegram на телефоне." Style="{StaticResource MirrlyTextSmallStyle}" FontWeight="SemiBold" Foreground="{ThemeResource BrandElectricBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card: Step 2 -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1.5">
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <!-- Шестеренка -->
                                                                <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41L9.25 5.35c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.73 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.3-.06.63-.06.94s.02.64.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .43-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.49-.12-.61l-2.03-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                                                      Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="ШАГ 2. Настройка Tailscale на ПК (Exit Node)" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="1. Скачайте и установите Tailscale для Windows." Style="{StaticResource MirrlyTextSmallStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        <Button Grid.Column="1" Click="OpenTailscaleDownload_Click" Height="32" Padding="12,0">
                                                            <TextBlock Text="Скачать Tailscale" FontSize="11" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Text="2. Войдите под своим аккаунтом (Google / Microsoft / GitHub)." Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="3. Включите Выходной Узел на ПК:" Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="16,0,0,0" Text="В трее Windows (возле часов) нажмите ПКМ по Tailscale ➔ Exit Node ➔ поставьте галочку 'Run as exit node...'" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" />
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                                        <TextBlock Grid.Column="0" Text="4. Подтвердите Exit Node в панели управления:" Style="{StaticResource MirrlyTextSmallStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        <Button Grid.Column="1" Click="OpenTailscaleAdmin_Click" Height="32" Padding="12,0">
                                                            <TextBlock Text="Админ-панель" FontSize="11" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Margin="16,0,0,0" Text="В панели управления напротив ПК нажмите '...' ➔ Edit route settings... ➔ включите 'Use as exit node' ➔ Save." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card: Step 3 (PowerShell) -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                                        <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1.5">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <!-- Молния -->
                                                                    <Path Data="M7 2v11h3v9l7-12h-4l4-8z"
                                                                          Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock Text="ШАГ 3. Настройка системных служб Windows" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Click="CopyPowerShellScript_Click" Height="36" Style="{StaticResource PremiumAccentButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                            <TextBlock Text="Скопировать скрипт" FontSize="11" FontWeight="Bold" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="Запустите PowerShell от имени администратора и выполните чистые команды (копируются без комментариев):" Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                <Border CornerRadius="8" Background="#14000000" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1" Padding="12">
                                                    <TextBox x:Name="PowerShellScriptBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11.5" Background="Transparent" BorderThickness="0"
                                                             Text="Set-NetIPInterface -Forwarding Enabled&#10;reg add HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters /v IPEnableRouter /t REG_DWORD /d 1 /f&#10;netsh interface portproxy reset&#10;netsh interface portproxy add v4tov4 listenport=1443 listenaddress=0.0.0.0 connectport=1080 connectaddress=127.0.0.1&#10;New-NetFirewallRule -DisplayName &quot;TgWsProxy Tailscale 1443&quot; -Direction Inbound -Action Allow -Protocol TCP -LocalPort 1443&#10;net stop tailscaled; net start tailscaled" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>

                                    <!-- ─────────────── COLUMN 2: Step 4 + Step 5 + Troubleshooting ─────────────── -->
                                    <StackPanel Grid.Column="1" Spacing="12">

                                        <!-- Card: Step 4 (Phone & Telegram) -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1.5">
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <!-- Телефон -->
                                                                <Path Data="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"
                                                                      Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="ШАГ 4. Настройка мобильного телефона" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Sub 1: Tailscale -->
                                                <Border CornerRadius="8" Padding="12" Background="#0AFFFFFF" BorderThickness="1" BorderBrush="{ThemeResource IconBorderBrush}">
                                                    <StackPanel Spacing="6">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource BrandElectricBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="1. Подключение к сети (Tailscale):" FontWeight="SemiBold" Style="{StaticResource MirrlyTextSmallStyle}" Foreground="{ThemeResource BrandElectricBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="1. Скачайте Tailscale из App Store или Google Play." Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Text="2. Войдите под тем же самым аккаунтом, что и на ПК." Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Text="3. Отключите Wi-Fi на телефоне (останьтесь на мобильном 4G/5G)." Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Text="4. Включите главный тумблер в Tailscale ➔ Exit Node ➔ выберите ваш ПК." Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Text="5. Скопируйте Tailscale IP вашего ПК (вид 100.x.y.z)." Style="{StaticResource MirrlyTextSmallStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Sub 2: Telegram -->
                                                <Border CornerRadius="8" Padding="12" Background="#0AFFFFFF" BorderThickness="1" BorderBrush="{ThemeResource IconBorderBrush}">
                                                    <StackPanel Spacing="6">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE709;" FontSize="12" Foreground="{ThemeResource BrandElectricBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="2. Настройка Telegram:" FontWeight="SemiBold" Style="{StaticResource MirrlyTextSmallStyle}" Foreground="{ThemeResource BrandElectricBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="1. Telegram ➔ Настройки ➔ Данные и память ➔ Прокси ➔ Добавить прокси." Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Text="2. Тип: MTProto." Style="{StaticResource MirrlyTextSmallStyle}" FontWeight="SemiBold" />
                                                        <TextBlock Text="3. Параметры:" Style="{StaticResource MirrlyTextSmallStyle}" />
                                                        <StackPanel Margin="16,0,0,0" Spacing="2">
                                                            <TextBlock Text="• Сервер: [Tailscale IP вашего ПК, например 100.115.80.20]" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" />
                                                            <TextBlock Text="• Порт: 1443" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" />
                                                            <TextBlock Text="• Ключ (Секрет): [Секрет, скопированный из TgWsProxy]" Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock Text="4. Сохраните и включите прокси." Style="{StaticResource MirrlyTextSmallStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card: Step 5 (Verification) -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                                        <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource IconBorderBackground}" BorderBrush="{ThemeResource IconBorderBrush}" BorderThickness="1.5">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <!-- Проверка / галочка в круге -->
                                                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                                                          Stroke="{ThemeResource BrandElectricBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock Text="ШАГ 5. Проверка работы" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Click="Open2Ip_Click" Height="32" Padding="12,0">
                                                        <TextBlock Text="Открыть 2ip.ru" FontSize="11" />
                                                    </Button>
                                                </Grid>
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="1. Проверка общего трафика:" FontWeight="SemiBold" Style="{StaticResource MirrlyTextSmallStyle}" />
                                                    <TextBlock Text="Перейдите на 2ip.ru в браузере телефона. Там должен быть ваш домашний IP ПК. YouTube на телефоне должен проигрывать видео в 4K через Запрет." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" />
                                                    <TextBlock Text="2. Проверка Telegram:" FontWeight="SemiBold" Style="{StaticResource MirrlyTextSmallStyle}" />
                                                    <TextBlock Text="В Telegram статус сменится на «Подключено» (зеленая галочка). Медиафайлы и каналы загружаются на максимальной скорости." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.85" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card: Troubleshooting -->
                                        <Border CornerRadius="{StaticResource CardCornerRadius}" Padding="18" Background="#0AD19A66" BorderThickness="1.5">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#D19A66" Offset="0.0" />
                                                    <GradientStop Color="#8C663D" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="#2B1A0E" BorderBrush="#D19A66" BorderThickness="1.5">
                                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <!-- Иконка помощи / вопроса -->
                                                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16h-2v-2h2v2zm1.07-7.75l-.9.92C12.45 11.9 12 12.5 12 14h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"
                                                                      Stroke="#D19A66" StrokeThickness="1.5" Fill="Transparent"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="Решение частых проблем (Troubleshooting)" FontWeight="SemiBold" Style="{StaticResource MirrlyTextLargeStyle}" Foreground="#D19A66" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="• Ошибка: 'Failed to start TCP Listener... Сделана попытка доступа к сокету методом, запрещенным правами доступа'" FontWeight="SemiBold" Style="{StaticResource MirrlyTextSmallStyle}" Foreground="#D19A66" TextWrapping="Wrap" />
                                                    <TextBlock Text="Причина: TgWsProxy привязан на порт, который занят netsh portproxy или Hyper-V.&#10;Решение: Держите TgWsProxy на порту 1080 и 127.0.0.1, а в netsh portproxy используйте listenport=1443." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.9" TextWrapping="Wrap" />

                                                    <TextBlock Text="• На телефоне сайты работают, но Telegram пишет «Соединение...»" FontWeight="SemiBold" Style="{StaticResource MirrlyTextSmallStyle}" Foreground="#D19A66" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="Причина: Забыли прописать прокси MTProto в Telegram или ввели не тот порт.&#10;Решение: Убедитесь, что в Telegram указан порт 1443 и вставлен верный секрет." Style="{StaticResource MirrlyTextSmallStyle}" Opacity="0.9" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </TabViewItem.Content>
                </TabViewItem>

            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>
